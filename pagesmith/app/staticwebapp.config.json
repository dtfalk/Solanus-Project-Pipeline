{
  "routes": [
    { "route": "/.auth/login/github", "statusCode": 404 },

    { "route": "/api/ping", "allowedRoles": ["anonymous"] },
    { "route": "/api/submit-questionnaire", "allowedRoles": ["anonymous"] },
    { "route": "/api/stats-refresh", "allowedRoles": ["anonymous"] },

    { "route": "/api/save-content/*", "allowedRoles": ["editor"] },
    { "route": "/api/media-upload", "allowedRoles": ["editor"] },
    { "route": "/api/media", "allowedRoles": ["editor"] },
    { "route": "/api/promote", "allowedRoles": ["editor"] },
    { "route": "/api/revert", "allowedRoles": ["editor"] },
    { "route": "/api/questionnaire-export", "allowedRoles": ["editor"] },

    { "route": "/showcase", "rewrite": "/html-pages/page.html" },

    { "route": "/p/*", "rewrite": "/html-pages/page.html" }
  ],

  "responseOverrides": {
    "401": { "statusCode": 302, "redirect": "/.auth/login/aad" }
  },

  "navigationFallback": {
    "rewrite": "/html-pages/page.html",
    "exclude": [
      "/.auth/*", "/api/*", "/css/*", "/javascript/*", "/media-content/*",
      "/data/*", "/html-pages/*",
      "/*.{css,js,json,png,jpg,jpeg,webp,gif,svg,ico,mp4,webm,woff,woff2,txt,xml,map}"
    ]
  }
}
